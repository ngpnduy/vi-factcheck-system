# Copy this file to .env and fill only the variables needed for your workflow.
# Never commit .env or any credential.

# Optional: Hugging Face access for gated models or dataset downloads.
HF_TOKEN=

# Optional: provider key for the LLM prompting baseline.
OPENAI_API_KEY=

# Optional: experiment tracking. Keep disabled unless the team agrees to use it.
WANDB_MODE=disabled
WANDB_API_KEY=

# Local paths. These defaults keep all generated artifacts inside this repository.
FACTCHECK_DATA_DIR=data
FACTCHECK_OUTPUT_DIR=outputs
